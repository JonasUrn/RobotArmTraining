<?xml version="1.0"?>
<robot name="arm">
  <link name="base">
    <visual><origin xyz="0 0 0.02"/><geometry><box size="0.1 0.1 0.04"/></geometry><material name="g"><color rgba="0.3 0.3 0.3 1"/></material></visual>
    <collision><origin xyz="0 0 0.02"/><geometry><box size="0.1 0.1 0.04"/></geometry></collision>
    <inertial><mass value="0"/><inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="link1">
    <visual><origin xyz="0 0 0.15"/><geometry><cylinder length="0.3" radius="0.03"/></geometry><material name="b"><color rgba="0.2 0.4 0.8 1"/></material></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><cylinder length="0.3" radius="0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 0.15"/><mass value="0.5"/><inertia ixx="0.01" iyy="0.01" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="j1" type="revolute">
    <parent link="base"/><child link="link1"/>
    <origin xyz="0 0 0.04"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="3"/>
  </joint>

  <link name="link2">
    <visual><origin xyz="0.15 0 0" rpy="0 1.5707963 0"/><geometry><cylinder length="0.3" radius="0.025"/></geometry><material name="r"><color rgba="0.8 0.3 0.3 1"/></material></visual>
    <collision><origin xyz="0.15 0 0" rpy="0 1.5707963 0"/><geometry><cylinder length="0.3" radius="0.025"/></geometry></collision>
    <inertial><origin xyz="0.15 0 0"/><mass value="0.3"/><inertia ixx="0.001" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="j2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="3"/>
  </joint>

  <link name="link3">
    <visual><origin xyz="0.125 0 0" rpy="0 1.5707963 0"/><geometry><cylinder length="0.25" radius="0.02"/></geometry><material name="y"><color rgba="0.9 0.7 0.2 1"/></material></visual>
    <collision><origin xyz="0.125 0 0" rpy="0 1.5707963 0"/><geometry><cylinder length="0.25" radius="0.02"/></geometry></collision>
    <inertial><origin xyz="0.125 0 0"/><mass value="0.2"/><inertia ixx="0.0005" iyy="0.003" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="j3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0.3 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="3"/>
  </joint>

  <link name="ee">
    <visual><geometry><sphere radius="0.025"/></geometry><material name="k"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><geometry><sphere radius="0.02"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="ee_fixed" type="fixed">
    <parent link="link3"/><child link="ee"/>
    <origin xyz="0.25 0 0"/>
  </joint>

  <link name="finger_l">
    <visual><geometry><box size="0.05 0.005 0.02"/></geometry><material name="k"/></visual>
    <collision><geometry><box size="0.05 0.005 0.02"/></geometry></collision>
    <inertial><mass value="0.005"/><inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="fl" type="prismatic">
    <parent link="ee"/><child link="finger_l"/>
    <origin xyz="0.03 0.0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.012" upper="0.04" effort="30" velocity="0.5"/>
  </joint>

  <link name="finger_r">
    <visual><geometry><box size="0.05 0.005 0.02"/></geometry><material name="k"/></visual>
    <collision><geometry><box size="0.05 0.005 0.02"/></geometry></collision>
    <inertial><mass value="0.005"/><inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="fr" type="prismatic">
    <parent link="ee"/><child link="finger_r"/>
    <origin xyz="0.03 0.0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.012" upper="0.04" effort="30" velocity="0.5"/>
  </joint>
</robot>
